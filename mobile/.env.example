# ═══════════════════════════════════════════════════════════════════
# Mogu Mobile App — Environment Variables Template (.env.example)
# ═══════════════════════════════════════════════════════════════════

# LAN IP của máy host backend:
# - Máy thật: http://<YOUR_LAN_IP>:3001/v1 (vd: http://192.168.1.10:3001/v1)
# - Máy ảo Android Emulator: http://10.0.2.2:3001/v1
# - Web / iOS Simulator: http://localhost:3001/v1
EXPO_PUBLIC_API_URL=http://localhost:3001/v1

# Supabase URL:
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Geoapify API Key (Tìm kiếm quán ăn lân cận):
EXPO_PUBLIC_GEOAPIFY_API_KEY=
