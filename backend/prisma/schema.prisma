model Allergen {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique // e.g. "PEANUT", "MILK", "GLUTEN"
  name         String
  description  String? // Ví dụ nguyên liệu cần tránh
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  userAllergens UserAllergen[]
  dishAllergens DishAllergen[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("allergens")
}

model UserAllergen {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  allergenId String   @map("allergen_id") @db.Uuid
  allergen   Allergen @relation(fields: [allergenId], references: [id])

  severity    String? // "mild", "severe" Ã¢â¬â optional
  confirmedAt DateTime? @map("confirmed_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, allergenId])
  @@map("user_allergens")
}

model UserAvoidedIngredient {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  ingredientName String  @map("ingredient_name") // free text, max 80 chars
  reason         String?

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, ingredientName])
  @@map("user_avoided_ingredients")
}

