// -----------------------------------------------------------------------------
// BA-005 Explore: Enums
// -----------------------------------------------------------------------------

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("article_status")
}

enum PostStatus {
  ACTIVE
  HIDDEN
  DELETED

  @@map("post_status")
}

// -----------------------------------------------------------------------------
// BA-005 Explore: Topic  Ch? d? do admin qu?n lý
// -----------------------------------------------------------------------------

model Topic {
  id            String   @id @default(uuid()) @db.Uuid
  slug          String   @unique @db.VarChar(120)
  title         String   @db.VarChar(200)
  description   String?
  coverImageUrl String?  @map("cover_image_url")
  displayOrder  Int      @default(0) @map("display_order")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  articles Article[]

  @@index([isActive, displayOrder])
  @@map("topics")
}

// -----------------------------------------------------------------------------
// BA-005 Explore: Article  Bài vi?t (admin ho?c user t?o)
// -----------------------------------------------------------------------------

model Article {
  id            String        @id @default(uuid()) @db.Uuid
  slug          String        @unique @db.VarChar(200)
  title         String        @db.VarChar(300)
  summary       String?
  content       String // Markdown
  coverImageUrl String?       @map("cover_image_url")
  status        ArticleStatus @default(DRAFT)
  readMinutes   Int           @default(3) @map("read_minutes")
  viewCount     Int           @default(0) @map("view_count")

  authorId String  @map("author_id") @db.Uuid
  author   Profile @relation(fields: [authorId], references: [userId], onDelete: Cascade)

  topicId String? @map("topic_id") @db.Uuid
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tags ArticleTag[]

  @@index([status, createdAt(sort: Desc)])
  @@index([topicId])
  @@index([authorId])
  @@map("articles")
}

model ArticleTag {
  id        String  @id @default(uuid()) @db.Uuid
  articleId String  @map("article_id") @db.Uuid
  article   Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag       String  @db.VarChar(60)

  @@unique([articleId, tag])
  @@index([tag])
  @@map("article_tags")
}

// -----------------------------------------------------------------------------
// BA-005 Explore: CommunityPost  Bài dang c?ng d?ng
// -----------------------------------------------------------------------------

model CommunityPost {
  id           String     @id @default(uuid()) @db.Uuid
  authorId     String     @map("author_id") @db.Uuid
  author       Profile    @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  content      String
  imageUrls    String[]   @map("image_urls")
  status       PostStatus @default(ACTIVE)
  likeCount    Int        @default(0) @map("like_count")
  commentCount Int        @default(0) @map("comment_count")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  likes    PostLike[]
  comments PostComment[]

  @@index([status, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("community_posts")
}

model PostLike {
  id     String        @id @default(uuid()) @db.Uuid
  postId String        @map("post_id") @db.Uuid
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String        @map("user_id") @db.Uuid
  user   Profile       @relation(fields: [userId], references: [userId], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([postId, userId])
  @@index([userId])
  @@map("post_likes")
}

model PostComment {
  id       String        @id @default(uuid()) @db.Uuid
  postId   String        @map("post_id") @db.Uuid
  post     CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String        @map("author_id") @db.Uuid
  author   Profile       @relation(fields: [authorId], references: [userId], onDelete: Cascade)
  content  String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("post_comments")
}

// -----------------------------------------------------------------------------
// BA-005: Weekly Meal Plan
// -----------------------------------------------------------------------------

enum WeeklyPlanStatus {
  GENERATING
  READY
  ACTIVE
  COMPLETED
  FAILED
  CANCELLED
  ARCHIVED

  @@map("weekly_plan_status")
}

enum WeeklyPlanSlotStatus {
  PLANNED
  COMPLETED
  SKIPPED

  @@map("weekly_plan_slot_status")
}

enum WeeklyMealSlot {
  MORNING
  LUNCH
  DINNER
  SNACK

  @@map("weekly_meal_slot")
}

enum WeeklyKcalMode {
  PROFILE
  CUSTOM

  @@map("weekly_kcal_mode")
}

enum WeeklyPlanSwapReason {
  USER_REQUEST
  REBALANCE_BUDGET
  REBALANCE_CALORIES
  DISH_UNAVAILABLE
  DIET_CONFLICT
  OTHER

  @@map("weekly_plan_swap_reason")
}

model WeeklyPlanConfig {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  budgetVnd  Int            @map("budget_vnd")
  kcalPerDay Int            @map("kcal_per_day")
  kcalMode   WeeklyKcalMode @default(PROFILE) @map("kcal_mode")

  durationDays Int @default(7) @map("duration_days")
  mealsPerDay  Int @default(3) @map("meals_per_day")

  enabledSlots WeeklyMealSlot[] @map("enabled_slots")

  avoidRepeat             Boolean @default(true) @map("avoid_repeat")
  preferHomeCook          Boolean @default(false) @map("prefer_home_cook")
  calorieTolerancePercent Int     @default(10) @map("calorie_tolerance_percent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  Profile      @relation(fields: [userId], references: [userId], onDelete: Cascade)
  plans WeeklyPlan[]

  @@map("weekly_plan_configs")
}

model WeeklyPlan {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  configId String @map("config_id") @db.Uuid

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  status WeeklyPlanStatus @default(GENERATING)

  budgetLimitVnd   Int @map("budget_limit_vnd")
  projectedCostVnd Int @default(0) @map("projected_cost_vnd")
  actualSpentVnd   Int @default(0) @map("actual_spent_vnd")

  targetKcal    Int @map("target_kcal")
  projectedKcal Int @default(0) @map("projected_kcal")
  actualKcal    Int @default(0) @map("actual_kcal")

  configSnapshot   Json   @map("config_snapshot")
  profileSnapshot  Json?  @map("profile_snapshot")
  algorithmVersion String @default("1.0") @map("algorithm_version")

  generationErrorCode String? @map("generation_error_code")
  generationErrorData Json?   @map("generation_error_data")

  startedAt   DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user   Profile          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  config WeeklyPlanConfig @relation(fields: [configId], references: [id], onDelete: Restrict)
  slots  WeeklyPlanSlot[]

  @@index([userId, status])
  @@index([userId, startDate])
  @@index([configId])
  @@map("weekly_plans")
}

model WeeklyPlanSlot {
  id     String @id @default(uuid()) @db.Uuid
  planId String @map("plan_id") @db.Uuid
  dishId String @map("dish_id") @db.Uuid

  date     DateTime             @db.Date
  mealSlot WeeklyMealSlot       @map("meal_slot")
  status   WeeklyPlanSlotStatus @default(PLANNED)

  servings Decimal @default(1) @db.Decimal(6, 2)

  isLocked  Boolean @default(false) @map("is_locked")
  swapCount Int     @default(0) @map("swap_count")

  dishNameSnapshot String  @map("dish_name_snapshot") @db.VarChar(150)
  imageUrlSnapshot String? @map("image_url_snapshot")
  priceSnapshotVnd Int     @map("price_snapshot_vnd")
  kcalSnapshot     Int     @map("kcal_snapshot")

  proteinGSnapshot Decimal? @map("protein_g_snapshot") @db.Decimal(8, 2)
  carbsGSnapshot   Decimal? @map("carbs_g_snapshot") @db.Decimal(8, 2)
  fatGSnapshot     Decimal? @map("fat_g_snapshot") @db.Decimal(8, 2)

  scoreSnapshot  Json? @map("score_snapshot")
  reasonSnapshot Json? @map("reason_snapshot")

  actualCostVnd Int? @map("actual_cost_vnd")
  actualKcal    Int? @map("actual_kcal")

  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  skippedAt   DateTime? @map("skipped_at") @db.Timestamptz(6)

  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan  WeeklyPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  dish  Dish                 @relation(fields: [dishId], references: [id], onDelete: Restrict)
  swaps WeeklyPlanSlotSwap[]

  @@unique([planId, date, mealSlot])
  @@index([planId, date])
  @@index([dishId])
  @@index([status])
  @@map("weekly_plan_slots")
}

model WeeklyPlanSlotSwap {
  id     String @id @default(uuid()) @db.Uuid
  slotId String @map("slot_id") @db.Uuid

  previousDishId String @map("previous_dish_id") @db.Uuid
  newDishId      String @map("new_dish_id") @db.Uuid

  previousCostVnd Int @map("previous_cost_vnd")
  newCostVnd      Int @map("new_cost_vnd")
  previousKcal    Int @map("previous_kcal")
  newKcal         Int @map("new_kcal")

  reason        WeeklyPlanSwapReason @default(USER_REQUEST)
  scoreSnapshot Json?                @map("score_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  slot WeeklyPlanSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  @@index([slotId, createdAt])
  @@map("weekly_plan_slot_swaps")
}

enum DishFileImportStatus {
  UPLOADED
  MAPPING
  VALIDATING
  READY
  QUEUED
  IMPORTING
  FINALIZING
  DONE
  FAILED
  CANCEL_REQUESTED
  CANCELLED
}

enum DishFileImportRowStatus {
  PENDING
  VALID
  WARNING
  ERROR
  DUPLICATE
  IMPORTED
  SKIPPED
  FAILED
}

enum ImportJobStatus {
  PENDING
  SEARCHING
  EXTRACTING
  NORMALIZING
  RECONCILING
  ENRICHING
  DRAFTING
  DONE
  FAILED
  CANCELLED

  @@map("import_job_status")
}

model ImportJob {
  id                      String          @id @default(uuid()) @db.Uuid
  query                   String          @db.VarChar(150)
  status                  ImportJobStatus @default(PENDING)
  currentStep             Int             @default(0) @map("current_step")
  totalSteps              Int             @default(6) @map("total_steps")
  progress                Int             @default(0)
  currentStepName         String?         @map("current_step_name") @db.VarChar(100)
  currentStepMessage      String?         @map("current_step_message")
  relatedKeywords         String[]        @default([]) @map("related_keywords")
  regionHint              String?         @map("region_hint") @db.VarChar(50)
  sourceTypes             String[]        @default(["AI_GENERATED"]) @map("source_types")
  resultDishId            String?         @unique @map("result_dish_id") @db.Uuid
  suggestedImageUrl       String?         @map("suggested_image_url")
  errorCode               String?         @map("error_code") @db.VarChar(100)
  errorMessage            String?         @map("error_message")
  completionPercent       Int             @default(0) @map("completion_percent")
  warnings                Json?
  unresolvedFields        String[]        @default([]) @map("unresolved_fields")
  taxonomySnapshotVersion String?         @map("taxonomy_snapshot_version") @db.VarChar(100)
  taxonomySnapshot        Json?           @map("taxonomy_snapshot")
  extractionSnapshot      Json?           @map("extraction_snapshot")
  normalizedSnapshot      Json?           @map("normalized_snapshot")
  resolutionSnapshot      Json?           @map("resolution_snapshot")
  nutritionSnapshot       Json?           @map("nutrition_snapshot")
  fieldMetadata           Json?           @map("field_metadata")
  auditMetadata           Json?           @map("audit_metadata")
  pipelineVersion         String          @default("1.1") @map("pipeline_version") @db.VarChar(32)
  schemaVersion           String          @default("1.1") @map("schema_version") @db.VarChar(32)
  provider                String?         @db.VarChar(100)
  model                   String?         @db.VarChar(200)
  idempotencyKey          String?         @unique @map("idempotency_key") @db.VarChar(100)
  requestedBy             String?         @map("requested_by") @db.Uuid
  cancelRequested         Boolean         @default(false) @map("cancel_requested")
  startedAt               DateTime?       @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(6)
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status, updatedAt])
  @@index([requestedBy, createdAt(sort: Desc)])
  @@map("import_jobs")
}

model DishFileImportSession {
  id               String               @id @default(uuid()) @db.Uuid
  createdById      String               @map("created_by_id") @db.Uuid
  originalFileName String               @map("original_file_name")
  mimeType         String               @default("text/csv") @map("mime_type")
  fileSizeBytes    Int                  @map("file_size_bytes")
  csvText          String               @map("csv_text")
  sheetName        String?              @map("sheet_name")
  headerRow        Int                  @default(1) @map("header_row")
  mappingSnapshot  Json?                @map("mapping_snapshot")
  optionsSnapshot  Json?                @map("options_snapshot")
  status           DishFileImportStatus @default(UPLOADED)
  totalRows        Int                  @default(0) @map("total_rows")
  eligibleRows     Int                  @default(0) @map("eligible_rows")
  errorCount       Int                  @default(0) @map("error_count")
  warningCount     Int                  @default(0) @map("warning_count")
  duplicateCount   Int                  @default(0) @map("duplicate_count")
  createdCount     Int                  @default(0) @map("created_count")
  skippedCount     Int                  @default(0) @map("skipped_count")
  failedCount      Int                  @default(0) @map("failed_count")
  jobId            String?              @map("job_id")
  cancelRequested  Boolean              @default(false) @map("cancel_requested")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  rows             DishFileImportRow[]

  @@index([createdById, createdAt])
  @@index([status, updatedAt])
  @@map("dish_file_import_sessions")
}

model DishFileImportRow {
  id              String                  @id @default(uuid()) @db.Uuid
  sessionId       String                  @map("session_id") @db.Uuid
  rowNumber       Int                     @map("row_number")
  rawData         Json                    @map("raw_data")
  normalizedData  Json?                   @map("normalized_data")
  issues          Json?
  status          DishFileImportRowStatus @default(PENDING)
  duplicateDishId String?                 @map("duplicate_dish_id") @db.Uuid
  createdDishId   String?                 @map("created_dish_id") @db.Uuid
  processedAt     DateTime?               @map("processed_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  session         DishFileImportSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, rowNumber])
  @@index([sessionId, status])
  @@map("dish_file_import_rows")
}

model DishEditorAuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  dishId     String?  @map("dish_id") @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  action     String
  fromStatus String?  @map("from_status")
  toStatus   String?  @map("to_status")
  payload    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([dishId, createdAt])
  @@map("dish_editor_audit_logs")
}

// ── Health diary (docs 01 / 03) — separate from legacy Meal/MealLog ────────────

enum DiaryMealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK

  @@map("diary_meal_slot")
}

enum DiaryMealSourceType {
  DISH
  INGREDIENT
  CUSTOM
  RANDOM
  WEEKLY_PLAN
  CAMERA
  MANUAL

  @@map("diary_meal_source_type")
}

enum DiaryItemReferenceType {
  DISH
  INGREDIENT
  CUSTOM_FOOD

  @@map("diary_item_reference_type")
}

model DiaryMealLog {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  profile  Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  mealSlot   DiaryMealSlot @map("meal_slot")
  occurredAt DateTime      @map("occurred_at")
  localDate  DateTime      @map("local_date") @db.Date
  timezone   String        @default("Asia/Ho_Chi_Minh") @db.VarChar(64)

  sourceType         DiaryMealSourceType @map("source_type")
  randomizationId    String?             @map("randomization_id") @db.Uuid
  weeklyPlanSlotId   String?             @map("weekly_plan_slot_id") @db.Uuid
  note               String?

  totalKcal    Int      @default(0) @map("total_kcal")
  totalProteinG Decimal? @map("total_protein_g") @db.Decimal(8, 2)
  totalCarbsG   Decimal? @map("total_carbs_g") @db.Decimal(8, 2)
  totalFatG     Decimal? @map("total_fat_g") @db.Decimal(8, 2)
  nutritionCoverage Decimal? @map("nutrition_coverage") @db.Decimal(5, 4)

  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  items DiaryMealLogItem[]

  @@unique([weeklyPlanSlotId])
  @@index([userId, localDate, occurredAt])
  @@index([userId, occurredAt(sort: Desc)])
  @@map("diary_meal_logs")
}

model DiaryMealLogItem {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mealLogId  String       @map("meal_log_id") @db.Uuid
  mealLog    DiaryMealLog @relation(fields: [mealLogId], references: [id], onDelete: Cascade)

  referenceType DiaryItemReferenceType @map("reference_type")
  referenceId   String?                @map("reference_id") @db.Uuid
  displayName   String                 @map("display_name") @db.VarChar(200)

  quantity       Decimal  @db.Decimal(10, 3)
  unitCode       String   @default("SERVING") @map("unit_code") @db.VarChar(32)
  gramEquivalent Decimal? @map("gram_equivalent") @db.Decimal(10, 3)

  caloriesSnapshot Decimal? @map("calories_snapshot") @db.Decimal(8, 2)
  proteinGSnapshot Decimal? @map("protein_g_snapshot") @db.Decimal(8, 2)
  carbsGSnapshot   Decimal? @map("carbs_g_snapshot") @db.Decimal(8, 2)
  fatGSnapshot     Decimal? @map("fat_g_snapshot") @db.Decimal(8, 2)
  nutritionBasis   String?  @map("nutrition_basis") @db.VarChar(32)

  sortOrder Int @default(0) @map("sort_order")

  @@index([mealLogId])
  @@map("diary_meal_log_items")
}

model WaterLog {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  profile  Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  amountMl   Int      @map("amount_ml")
  occurredAt DateTime @map("occurred_at")
  localDate  DateTime @map("local_date") @db.Date
  timezone   String   @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  source     String   @default("MANUAL") @db.VarChar(32)
  idempotencyKey String? @unique @map("idempotency_key") @db.VarChar(128)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, localDate, occurredAt])
  @@map("water_logs")
}

model CustomFood {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  profile     Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  name        String   @db.VarChar(200)
  calories    Decimal  @db.Decimal(8, 2)
  proteinG    Decimal? @map("protein_g") @db.Decimal(8, 2)
  fatG        Decimal? @map("fat_g") @db.Decimal(8, 2)
  carbsG      Decimal? @map("carbs_g") @db.Decimal(8, 2)
  servingSize String?  @map("serving_size") @db.VarChar(100)
  version     Int      @default(1)

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  @@index([userId, name])
  @@map("custom_foods")
}

model ProfileMeasurement {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  profile      Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  type         String   @db.VarChar(32)
  valueDecimal Decimal  @map("value_decimal") @db.Decimal(8, 2)
  unit         String   @default("kg") @db.VarChar(16)

  measuredAt DateTime @default(now()) @map("measured_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, type, measuredAt(sort: Desc)])
  @@map("profile_measurements")
}

model HealthTarget {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  profile    Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  mode       String   @default("SYSTEM_ESTIMATED") @db.VarChar(32)
  energyKcal Int?     @map("energy_kcal")
  proteinG   Float?   @map("protein_g")
  carbsG     Float?   @map("carbs_g")
  fatG       Float?   @map("fat_g")
  waterMl    Int?     @map("water_ml")
  steps      Int?
  version    Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("health_targets")
}

model ActivityBucket {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)

  provider  String   @db.VarChar(64)
  type      String   @db.VarChar(32)
  startAt   DateTime @map("start_at")
  endAt     DateTime @map("end_at")
  value     Decimal  @db.Decimal(12, 2)
  dedupeKey String?  @map("dedupe_key") @db.VarChar(128)

  syncedAt  DateTime @default(now()) @map("synced_at")

  @@unique([userId, provider, type, startAt, endAt, dedupeKey])
  @@map("activity_buckets")
}
