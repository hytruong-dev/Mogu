// BA-006 enums
enum RandomizationStatus {
  PROCESSING
  COMPLETED
  NO_CANDIDATE
  CANCELLED
  FAILED

  @@map("randomization_status")
}

enum RecommendationSource {
  RANDOM_FLOW
  RANDOM_AGAIN
  HOME_QUICK_RANDOM
  WEEKLY_PLAN_SWAP

  @@map("recommendation_source")
}

enum MealSelectionSource {
  AUTO_TIME
  USER_SELECTED
  PROFILE_DEFAULT
  SYSTEM_DEFAULT

  @@map("meal_selection_source")
}

enum BudgetMode {
  EXPLICIT_RANGE
  ECONOMY_PROFILE
  PROFILE_DEFAULT
  UNLIMITED

  @@map("budget_mode")
}

enum RecommendationEventType {
  IMPRESSION
  OPEN_DETAIL
  SELECT
  RETRY
  SAVE
  SHARE
  DISLIKE
  NOT_RELEVANT
  TOO_EXPENSIVE
  TOO_FAR
  ALLERGY_CONCERN
  DISMISS

  @@map("recommendation_event_type")
}

model RandomHistory {
  id     String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String  @map("user_id") @db.Uuid
  dishId String? @map("dish_id") @db.Uuid

  // BA-006: session & attempt tracking
  sessionId               String               @default(dbgenerated("gen_random_uuid()")) @map("session_id") @db.Uuid
  previousRandomizationId String?              @map("previous_randomization_id") @db.Uuid
  idempotencyKey          String?              @map("idempotency_key") @db.VarChar(100)
  status                  RandomizationStatus  @default(COMPLETED)
  source                  RecommendationSource @default(RANDOM_FLOW)
  attemptNo               Int                  @default(1) @map("attempt_no")

  // BA-006: meal & budget context
  mealSlot            String?             @map("meal_slot") @db.VarChar(20)
  mealSelectionSource MealSelectionSource @default(AUTO_TIME) @map("meal_selection_source")
  budgetMode          BudgetMode          @default(UNLIMITED) @map("budget_mode")
  budgetMinVnd        Int?                @map("budget_min_vnd")
  budgetMaxVnd        Int?                @map("budget_max_vnd")

  // BA-006: profile snapshot
  profileVersion   Int   @default(1) @map("profile_version")
  criteriaSnapshot Json  @map("criteria_snapshot")
  profileSnapshot  Json? @map("profile_snapshot")
  fallbackSnapshot Json? @map("fallback_snapshot")

  // BA-006: algorithm metadata
  algorithmVersion String  @default("rule-v2.0.0") @map("algorithm_version") @db.VarChar(32)
  randomSeed       String? @map("random_seed") @db.VarChar(64)
  candidateCount   Int     @default(0) @map("candidate_count")
  durationMs       Int?    @map("duration_ms")

  // BA-006: result
  totalScore           Decimal? @map("total_score") @db.Decimal(6, 3)
  compatibilityPercent Int?     @map("compatibility_percent")
  scoreBreakdown       Json?    @map("score_breakdown")
  reasonSnapshot       Json?    @map("reason_snapshot")

  // BA-006: selection
  isSelected     Boolean   @default(false) @map("is_selected")
  selectedAt     DateTime? @map("selected_at") @db.Timestamptz(6)
  failReasonCode String?   @map("fail_reason_code") @db.VarChar(64)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  dish       Dish?                 @relation(fields: [dishId], references: [id], onDelete: SetNull)
  candidates RandomCandidate[]
  events     RecommendationEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([sessionId, attemptNo])
  @@index([dishId, createdAt(sort: Desc)])
  @@map("random_histories")
}

// BA-006: Top candidates per randomization (audit & debug)
model RandomCandidate {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  randomHistoryId String   @map("random_history_id") @db.Uuid
  dishId          String   @map("dish_id") @db.Uuid
  rank            Int
  totalScore      Decimal  @map("total_score") @db.Decimal(6, 3)
  samplingWeight  Decimal  @map("sampling_weight") @db.Decimal(12, 8)
  scoreBreakdown  Json     @map("score_breakdown")
  isChosen        Boolean  @default(false) @map("is_chosen")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  randomHistory RandomHistory @relation(fields: [randomHistoryId], references: [id], onDelete: Cascade)
  dish          Dish          @relation(fields: [dishId], references: [id], onDelete: Restrict)

  @@unique([randomHistoryId, dishId])
  @@index([randomHistoryId, rank])
  @@map("random_candidates")
}

// BA-006: User feedback events on recommendations
model RecommendationEvent {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  randomHistoryId String?                 @map("random_history_id") @db.Uuid
  dishId          String?                 @map("dish_id") @db.Uuid
  eventType       RecommendationEventType @map("event_type")
  reasonCode      String?                 @map("reason_code") @db.VarChar(64)
  metadata        Json?
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  randomHistory RandomHistory? @relation(fields: [randomHistoryId], references: [id], onDelete: SetNull)
  dish          Dish?          @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, dishId, createdAt(sort: Desc)])
  @@index([randomHistoryId])
  @@map("recommendation_events")
}

