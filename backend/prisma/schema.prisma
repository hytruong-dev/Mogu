// Meals & MealLogs
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
model Meal {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  type  MealType
  date  DateTime   @db.Date
  items MealItem[]
  logs  MealLog[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, type, date])
  @@map("meals")
}

model MealItem {
  id     String @id @default(uuid()) @db.Uuid
  mealId String @map("meal_id") @db.Uuid
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  foodId String @map("food_id") @db.Uuid
  food   Food   @relation(fields: [foodId], references: [id])

  quantity Float  @default(1)
  grams    Float?

  @@map("meal_items")
}

model MealLog {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  mealId String @map("meal_id") @db.Uuid
  meal   Meal   @relation(fields: [mealId], references: [id], onDelete: Cascade)

  loggedAt  DateTime @default(now()) @map("logged_at")
  totalKcal Int      @map("total_kcal")
  note      String?

  @@map("meal_logs")
}

// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
// BA-004: Taxonomy
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

model Region {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar(50)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  provinces Province[]
  dishes    Dish[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("regions")
}

model Province {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar(50)
  name     String  @db.VarChar(100)
  regionId String  @map("region_id") @db.Uuid
  region   Region  @relation(fields: [regionId], references: [id], onDelete: Restrict)
  isActive Boolean @default(true) @map("is_active")

  dishes Dish[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("provinces")
}

model DishCategory {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique @db.VarChar(50)
  name         String  @db.VarChar(100)
  description  String?
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  dishes DishCategoryLink[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("dish_categories")
}

model MealTypeTag {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique @db.VarChar(50)
  name         String  @db.VarChar(100)
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  dishes DishMealType[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("meal_type_tags")
}

model DietType {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String  @unique @db.VarChar(50)
  name         String  @db.VarChar(100)
  description  String?
  isActive     Boolean @default(true) @map("is_active")
  displayOrder Int     @default(0) @map("display_order")

  dishes        DishDietType[]
  userDietTypes UserDietType[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("diet_types")
}

model Ingredient {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code         String   @unique @db.VarChar(100)
  name         String   @db.VarChar(200)
  synonyms     String[] @default([])
  unit         String?  @db.VarChar(50)
  allergenCode String?  @map("allergen_code") @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  imageUrl     String?  @map("image_url")
  imageKey     String?  @map("image_key") @db.VarChar(500)

  dishIngredients DishIngredient[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("ingredients")
}

// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
// BA-004: Dish (full version per BA)
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

model Dish {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name             String     @db.VarChar(150)
  slug             String     @db.VarChar(180)
  alternateNames   String[]   @default([]) @map("alternate_names")
  searchText       String     @default("") @map("search_text")
  shortDescription String?    @map("short_description") @db.VarChar(300)
  fullDescription  String?    @map("full_description")
  status           DishStatus @default(DRAFT)

  regionId        String?         @map("region_id") @db.Uuid
  provinceId      String?         @map("province_id") @db.Uuid
  originText      String?         @map("origin_text") @db.VarChar(200)
  difficulty      DishDifficulty?
  prepMinutes     Int?            @map("prep_minutes") @db.SmallInt
  cookMinutes     Int?            @map("cook_minutes") @db.SmallInt
  servings        Decimal?        @db.Decimal(6, 2)
  primaryMealSlot String?         @map("primary_meal_slot") @db.VarChar(50)

  priceMin   Int?    @map("price_min")
  priceMax   Int?    @map("price_max")
  recipeTitle String? @map("recipe_title") @db.VarChar(200)
  flavorTags  String[] @default([]) @map("flavor_tags")
  currency   String  @default("VND") @db.Char(3)
  isFeatured Boolean @default(false) @map("is_featured")

  // Rating (denormalized, updated by trigger)
  ratingAvg   Decimal @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount Int     @default(0) @map("rating_count")

  // Self-relation for variants (max 1 level)
  parentDishId String? @map("parent_dish_id") @db.Uuid
  parentDish   Dish?   @relation("DishVariants", fields: [parentDishId], references: [id], onDelete: SetNull)
  variants     Dish[]  @relation("DishVariants")

  version        Int       @default(1)
  publishVersion Int       @default(0) @map("publish_version")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz(6)
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz(6)
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)

  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  region   Region?   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  province Province? @relation(fields: [provinceId], references: [id], onDelete: Restrict)

  categories           DishCategoryLink[]
  mealTypes            DishMealType[]
  dietTypes            DishDietType[]
  dishGoals            DishGoal[]
  dishIngredients      DishIngredient[]
  dishAllergens        DishAllergen[]
  nutrition            DishNutrition?
  recipeSteps          RecipeStep[]
  media                DishMedia[]
  sources              DishSource[]
  savedByUsers         SavedDish[]
  recLogs              RecommendationLog[]
  randomHistories      RandomHistory[]
  randomCandidates     RandomCandidate[]
  recommendationEvents RecommendationEvent[]
  reviews              Review[]
  weeklyPlanSlots      WeeklyPlanSlot[]

  @@index([status, publishedAt])
  @@index([regionId, provinceId])
  @@index([parentDishId])
  @@map("dishes")
}

// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
// BA-004: Junction tables
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ

model DishCategoryLink {
  dishId     String       @map("dish_id") @db.Uuid
  categoryId String       @map("category_id") @db.Uuid
  dish       Dish         @relation(fields: [dishId], references: [id], onDelete: Cascade)
  category   DishCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([dishId, categoryId])
  @@map("dish_category_links")
}

model DishMealType {
  dishId        String      @map("dish_id") @db.Uuid
  mealTypeTagId String      @map("meal_type_tag_id") @db.Uuid
  dish          Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  mealTypeTag   MealTypeTag @relation(fields: [mealTypeTagId], references: [id], onDelete: Restrict)

  @@id([dishId, mealTypeTagId])
  @@map("dish_meal_types")
}

model DishDietType {
  dishId     String   @map("dish_id") @db.Uuid
  dietTypeId String   @map("diet_type_id") @db.Uuid
  dish       Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)
  dietType   DietType @relation(fields: [dietTypeId], references: [id], onDelete: Restrict)

  @@id([dishId, dietTypeId])
  @@map("dish_diet_types")
}

model DishGoal {
  dishId String @map("dish_id") @db.Uuid
  goalId String @map("goal_id") @db.Uuid
  score  Int    @default(50)
  dish   Dish   @relation(fields: [dishId], references: [id], onDelete: Cascade)
  goal   Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@id([dishId, goalId])
  @@index([goalId, score])
  @@map("dish_goals")
}

model DishIngredient {
  id                   String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  dishId               String                      @map("dish_id") @db.Uuid
  ingredientId         String?                     @map("ingredient_id") @db.Uuid
  rawText              String                      @map("raw_text") @db.VarChar(200)
  parsedName           String?                     @map("parsed_name") @db.VarChar(200)
  quantity             Decimal?                    @db.Decimal(10, 3)
  quantityTo           Decimal?                    @map("quantity_to") @db.Decimal(10, 3)
  quantityText         String?                     @map("quantity_text") @db.VarChar(100)
  unit                 String?                     @db.VarChar(50)
  preparation          String?                     @db.VarChar(100)
  specification        String?                     @db.VarChar(200)
  alternativeNote      String?                     @map("alternative_note") @db.VarChar(200)
  normalizedWeightG    Decimal?                    @map("normalized_weight_g") @db.Decimal(10, 3)
  parseMetadata        Json?                       @map("parse_metadata")
  resolutionMethod     IngredientResolutionMethod? @map("resolution_method")
  resolutionConfidence Int?                        @map("resolution_confidence")
  resolutionCandidates Json?                       @map("resolution_candidates")
  needsReview          Boolean                     @default(false) @map("needs_review")
  isOptional           Boolean                     @default(false) @map("is_optional")
  groupLabel           String?                     @map("group_label") @db.VarChar(100)
  sortOrder            Int                         @default(0) @map("sort_order")

  dish       Dish        @relation(fields: [dishId], references: [id], onDelete: Cascade)
  ingredient Ingredient? @relation(fields: [ingredientId], references: [id], onDelete: SetNull)

  @@index([dishId])
  @@map("dish_ingredients")
}

enum IngredientResolutionMethod {
  EXACT
  ALIAS
  NORMALIZED
  FUZZY
  NONE

  @@map("ingredient_resolution_method")
}

model DishAllergen {
  dishId         String        @map("dish_id") @db.Uuid
  allergenId     String        @map("allergen_id") @db.Uuid
  level          AllergenLevel
  confidence     Int?
  resolved       Boolean       @default(false)
  resolutionNote String?       @map("resolution_note")
  dish           Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  allergen       Allergen      @relation(fields: [allergenId], references: [id], onDelete: Restrict)

  @@id([dishId, allergenId])
  @@map("dish_allergens")
}

