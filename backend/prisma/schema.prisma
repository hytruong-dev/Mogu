// Profiles Ã¢â¬â mirrors auth.users, quÃ¡ÂºÂ£n lÃÂ½ bÃ¡Â»Å¸i NestJS
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
model Profile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid
  // userId tham chiÃ¡ÂºÂ¿u auth.users.id Ã¢â¬â FK khÃÂ´ng khai bÃÂ¡o vÃÂ¬ auth schema khÃÂ¡c

  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  locale      String  @default("vi")
  timezone    String  @default("Asia/Ho_Chi_Minh")

  accountStatus    AccountStatus    @default(PENDING_VERIFICATION) @map("account_status")
  onboardingStatus OnboardingStatus @default(NOT_STARTED) @map("onboarding_status")
  onboardingStep   Int              @default(0) @map("onboarding_step")

  // ThÃÂªm trong v2: thÃÂ´ng tin cÃÂ¡ nhÃÂ¢n
  gender      Gender?
  dateOfBirth DateTime? @map("date_of_birth") @db.Date
  noAllergies Boolean   @default(false) @map("no_allergies") // "KhÃÂ´ng cÃÂ³ dÃ¡Â»â¹ Ã¡Â»Â©ng"

  // Health data (filled in onboarding)
  weightKg Float? @map("weight_kg")
  heightCm Float? @map("height_cm")
  goalKcal Int?   @map("goal_kcal")

  // Versioning Ã¢â¬â tÃÆng mÃ¡Â»âi lÃ¡ÂºÂ§n hoÃÂ n tÃ¡ÂºÂ¥t hoÃ¡ÂºÂ·c update
  profileVersion Int       @default(1) @map("profile_version")
  completedAt    DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  consents               UserConsent[]
  meals                  Meal[]
  mealLogs               MealLog[]
  onboardingSession      OnboardingSession?
  userGoals              UserGoal[]
  userDietaryPreferences UserDietaryPreference[]
  userAllergens          UserAllergen[]
  userAvoidedIngredients UserAvoidedIngredient[]
  savedDishes            SavedDish[]
  notifications          Notification[]
  profileRoles           ProfileRole[]
  userDietTypes          UserDietType[]
  reviews                Review[]
  articles               Article[]
  communityPosts         CommunityPost[]
  postLikes              PostLike[]
  postComments           PostComment[]
  weeklyPlanConfig       WeeklyPlanConfig?
  weeklyPlans            WeeklyPlan[]
  diaryMealLogs          DiaryMealLog[]
  waterLogs              WaterLog[]
  customFoods            CustomFood[]
  measurements           ProfileMeasurement[]
  healthTargets          HealthTarget[]
  activityBuckets        ActivityBucket[]

  @@map("profiles")
}

// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
// OnboardingSession Ã¢â¬â lÃÂ°u draft/resume/state per user
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
model OnboardingSession {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @unique @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  onboardingVersion String           @default("1.0") @map("onboarding_version")
  currentStep       Int              @default(1) @map("current_step")
  status            OnboardingStatus @default(IN_PROGRESS)
  dataJson          Json?            @map("data_json") // draft data per step (sanitized)

  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("onboarding_sessions")
}

// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
// Goals Ã¢â¬â catalog mÃ¡Â»Â¥c tiÃÂªu (seed data)
// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
model Goal {
  id           String  @id @default(uuid()) @db.Uuid
  code         String  @unique // e.g. "BALANCE", "LOSE_WEIGHT"
  name         String
  description  String?
  active       Boolean @default(true)
  displayOrder Int     @default(0) @map("display_order")

  userGoals UserGoal[]
  dishGoals DishGoal[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("goals")
}

model UserGoal {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  goalId String @map("goal_id") @db.Uuid
  goal   Goal   @relation(fields: [goalId], references: [id])

  priority GoalPriority

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, priority], name: "unique_primary_goal") // Enforce 1 primary at DB level... relaxed for secondary
  @@unique([userId, goalId])
  @@map("user_goals")
}

// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
