// âââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââââ
model DietaryPreference {
  id           String                @id @default(uuid()) @db.Uuid
  code         String                @unique // e.g. "SPICY", "VEGAN"
  type         DietaryPreferenceType
  name         String
  active       Boolean               @default(true)
  displayOrder Int                   @default(0) @map("display_order")

  userPreferences UserDietaryPreference[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("dietary_preferences")
}

model UserDietaryPreference {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @map("user_id") @db.Uuid
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  preferenceId String            @map("preference_id") @db.Uuid
  preference   DietaryPreference @relation(fields: [preferenceId], references: [id])

  strength Int @default(1) // 1=mild, 2=strong preference

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, preferenceId])
  @@map("user_dietary_preferences")
}

