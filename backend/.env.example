# ─────────────────────────────────────────────────────────────────
# Mogu Backend — Environment Variables
# Copy to .env.local for local development
# ─────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

# ── Supabase ──────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<id>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
SUPABASE_SECRET_KEY=sb_secret_<key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ── Database (Supabase PostgreSQL) ────────────────────────────────
# Get from: Supabase Dashboard → Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
# Direct connection (for Prisma migrations)
DIRECT_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Redis / BullMQ (optional for local) ───────────────────────────
# Leave unset or comment out if Redis is not running.
# App probes at startup: if unreachable, BullMQ is disabled and jobs use inline fallbacks.
# REDIS_URL=redis://localhost:6379
REDIS_URL=

# FoodScan: OpenAI-compatible provider with image input AND strict JSON-schema support.
# Missing credentials/provider produce an explicit 503; provider/model errors produce 502.
# If FOOD_SCAN_API_KEY is unset, XKIRO_API_KEY + XKIRO_BASE_URL may be reused.
# XKIRO_MODEL is NEVER inherited. Confirm your provider supports the chosen vision model.
FOOD_SCAN_API_KEY=
# With FOOD_SCAN_API_KEY, blank base defaults to https://api.openai.com/v1.
# Leave blank to inherit XKIRO_BASE_URL when using the fallback key instead.
FOOD_SCAN_BASE_URL=
FOOD_SCAN_MODEL=gpt-4o-mini
# Closed-set reranking model (defaults to FOOD_SCAN_MODEL if blank)
FOOD_SCAN_RERANK_MODEL=
# Whether to enable closed-set VLM rerank (defaults to true)
FOOD_SCAN_ENABLE_RERANK=true
# Local ONNX CLIP embedding model for text and image similarity (pgvector)
FOOD_SCAN_EMBED_MODEL=Xenova/clip-vit-base-patch32
# Private Supabase Storage bucket for photos of dishes missing from the catalog
# (admin queue "Món chưa có (Scan)"). Create it as a PRIVATE bucket.
FOOD_SCAN_REPORT_BUCKET=food-scan-reports
# Optional existing-provider fallback (both required if no FOOD_SCAN_API_KEY):
# XKIRO_API_KEY=
# XKIRO_BASE_URL=https://api.xkiro.com/v1

# Cook with NOAN: optional; missing credentials never prevent app startup.
# Azure is selected only when BOTH key and region are configured.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
COOKING_VOICE_NAME=vi-VN-HoaiMyNeural
# Explicit OpenAI audio credentials, NOT FOOD_SCAN/XKIRO credentials.
# Used for TTS only when Azure is unconfigured. Audio endpoint is api.openai.com.
COOKING_OPENAI_API_KEY=
COOKING_TTS_MODEL=gpt-4o-mini-tts
COOKING_OPENAI_VOICE=coral
# Optional pre-existing PUBLIC bucket for published recipe/static speech only.
# Never auto-created. Missing/inaccessible storage falls back to inline data audio.
# Arbitrary TTS and personalized answers NEVER persist here.
COOKING_VOICE_BUCKET=voice-cache
SUPABASE_SERVICE_ROLE_KEY=
# Explicit text-provider configuration; may be OpenAI-compatible (audio not assumed).
# Blank ASK key uses COOKING_OPENAI_API_KEY; blank base uses api.openai.com/v1.
COOKING_ASK_API_KEY=
COOKING_ASK_BASE_URL=
COOKING_ASK_MODEL=gpt-4o-mini
