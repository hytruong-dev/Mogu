# ═══════════════════════════════════════════════════════════════════
# Mogu Backend — Environment Variables Template (.env.example)
# Copy sang .env hoặc .env.local cho môi trường phát triển local
# ═══════════════════════════════════════════════════════════════════

# ── App & Network ──────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://172.28.0.166:3000,http://172.28.0.166:8081,http://172.28.0.166:8082

# ── Supabase Auth & Storage ────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-jwt-token>
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
SUPABASE_SECRET_KEY=sb_secret_<key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt-token>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_STORAGE_BUCKET=dish-images
FOOD_SCAN_REPORT_BUCKET=food-scan-reports

# ── Database (Supabase PostgreSQL) ─────────────────────────────────
# Transaction mode pooler (port 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) cho Prisma migrate
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ── AI LLM Models (Dish Import, Food Scan & Chat) ──────────────────
XKIRO_API_KEY=sk-...
XKIRO_BASE_URL=https://uu5kgf.taila632a3.ts.net/v1
XKIRO_MODEL=ag/gemini-3.8-flash
FOOD_SCAN_MODEL=ag/gemini-3.8-flash
FOOD_SCAN_ENABLE_RERANK=true
RANDOM_EXPLANATION_MODEL=ag/gemini-2.5-flash-lite

# ── AI Image Generation (Tự động vẽ ảnh món ăn chuẩn Studio) ───────
# Điền API Key khi cần kích hoạt tự động vẽ ảnh studio thay vì tìm kiếm ảnh:
OPENAI_API_KEY=
GEMINI_IMAGE_API_KEY=
# CUSTOM_IMAGE_GEN_URL=
# CUSTOM_IMAGE_GEN_KEY=

# ── External Fallbacks (Tìm kiếm & Dữ liệu bổ trợ) ─────────────────
TAVILY_API_KEY=tvly-...
UNSPLASH_ACCESS_KEY=
USDA_API_KEY=
GEOAPIFY_API_KEY=
AI_IMPORT_ENABLE_WEBSITE_JSONLD=true
AI_IMPORT_ENABLE_NUTRITION_DATABASES=true

# ── Redis / BullMQ (Tùy chọn) ──────────────────────────────────────
# REDIS_URL=redis://localhost:6379
