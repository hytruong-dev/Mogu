# ═══════════════════════════════════════════════════════════════════
# MOGU BACKEND — STAGING CONFIG
# Tạo Supabase project riêng cho staging, điền credentials bên dưới
# ═══════════════════════════════════════════════════════════════════

NODE_ENV=staging
PORT=3001

# ── App ──────────────────────────────────────────────────────────────────────
APP_NAME=Mogu Backend (Staging)
APP_VERSION=1.0.0

# ── Supabase STAGING (tạo project riêng) ─────────────────────────────────────
SUPABASE_URL=https://STAGING_PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_STAGING_KEY
SUPABASE_SECRET_KEY=sb_secret_STAGING_KEY
SUPABASE_SERVICE_ROLE_KEY=STAGING_SERVICE_ROLE_JWT
SUPABASE_JWKS_URL=https://STAGING_PROJECT_ID.supabase.co/auth/v1/.well-known/jwks.json

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:STAGING_PASSWORD@db.STAGING_PROJECT_ID.supabase.co:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres:STAGING_PASSWORD@db.STAGING_PROJECT_ID.supabase.co:5432/postgres?sslmode=require

# ── Redis (Upstash hoặc tự host) ──────────────────────────────────────────────
REDIS_URL=redis://STAGING_REDIS_HOST:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=STAGING_JWT_SECRET_MIN_32_CHARS

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://staging-admin.mogu.vn,https://staging.mogu.vn

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_STORAGE_BUCKET=dish-images-staging

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
PINO_PRETTY=false
